# systemd unit for WorkshopOne (Linux server option, alternative to pm2).
# 1. Edit the placeholders below (User, WorkingDirectory, paths).
# 2. sudo cp deploy/workshopone.service /etc/systemd/system/workshopone.service
# 3. sudo systemctl daemon-reload && sudo systemctl enable --now workshopone
# Manage with: systemctl {status|restart|stop} workshopone ; logs: journalctl -u workshopone -f

[Unit]
Description=WorkshopOne — Central Workshop Master System
After=network.target

[Service]
Type=simple
User=REPLACE_WITH_SERVICE_USER
WorkingDirectory=REPLACE_WITH_APP_DIR
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

# ANYTHING SET HERE BEATS .env. The .env loader in src/config.js only fills in keys that are not
# already in the real environment, so a value in this file silently wins.
#
# That is why HOST is NOT set here. This unit used to carry `Environment=HOST=0.0.0.0`, which is
# right for the LAN mini-PC but would have overridden the `HOST=127.0.0.1` line the VPS setup asks
# for — putting the app on the public interface beside nginx, where only the firewall stood between
# it and the internet. Leave HOST and PORT to .env, where each deployment states its own.
#
# Optional: mirror backups to a mounted drive/share
# Environment=BACKUP_MIRROR_DIR=/mnt/backup-drive/workshopone

[Install]
WantedBy=multi-user.target
