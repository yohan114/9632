node_modules/
*.log
npm-debug.log*
logs/

# Local database + backups (data is seeded/migrated, never committed)
data/*.db
data/*.db-shm
data/*.db-wal
backups/

# Uploaded evidence photos
uploads/*
!uploads/.gitkeep

# Environment
.env
.env.local

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Raw source uploads (curated CSVs live under sources/)
*.xlsx
sources/stores/inventory.db

# Generated review / analysis artifacts (produced by migrations, not source data)
cost_reconciliation.csv
asset_merge_candidates.csv
item_catalogue_final.csv
job_materials_unassigned.csv
general_issues_unallocated.csv
daily_work_unmatched_review.csv
unassigned_vehicles.csv
vehicle_merge_review.csv
SYSTEM_AUDIT_PLAN.json

# Throwaway scripts written to answer one question at the repo root and never re-run --
# _tmp_q.js, _tmp_repair3.js and so on. Named rather than globbed as *.js so that a real script
# saved to the wrong place still shows up in `git status` instead of vanishing silently.
_tmp_*

# Throwaway design preview
public/_mockup.html
sources/stores/tracker_backup.json

# SQLite WAL sidecars (transient)
*.db-shm
*.db-wal

# env backups carry the same secrets as .env
.env.bak-*
.env.*.bak
