# WorkshopOne environment configuration
# Copy to .env and adjust. Sensible defaults are used when unset.

# HTTP port the app listens on
PORT=3000

# SQLite database file (single-file DB, easy to back up — matches the current setup).
# Designed to port cleanly to PostgreSQL later.
DB_PATH=./data/workshopone.db

# Secret used to sign/rotate session tokens. CHANGE THIS in production.
SESSION_SECRET=change-me-in-production

# Session lifetime in hours
SESSION_TTL_HOURS=12

# Where uploaded evidence photos (battery serials, delivered parts, repairs) are stored
UPLOAD_DIR=./uploads

# Automatic DB backups
BACKUP_DIR=./backups
# How often to snapshot the DB, in minutes (0 disables). Both source systems back up hourly.
BACKUP_INTERVAL_MINUTES=60
# How many snapshots to retain
BACKUP_RETENTION=48

# Forecasting windows (from the existing Oil & Lubricant Stock Book settings)
FORECAST_WINDOW_DAYS=90
LOW_STOCK_DAYS=14
