# WorkshopOne environment configuration
# Copy to .env and adjust. Sensible defaults are used when unset.

# HTTP port the app listens on
PORT=3000

# Bind address. 0.0.0.0 makes the app reachable from other PCs/phones on the LAN.
#
# ON A PUBLIC SERVER SET THIS TO 127.0.0.1. Behind nginx the app should be reachable only from the
# machine itself; 0.0.0.0 puts it on the internet beside nginx, with TLS bypassed, and then only
# the firewall is keeping it private. See deploy/VPS.md.
HOST=0.0.0.0

# 'production' turns on the hardening in src/server.js: forwarding headers are believed only from a
# proxy on this machine (so a client cannot forge its address and walk through the login rate
# limiter), and the live-update socket stops accepting any origin. Leave unset for local work.
# NODE_ENV=production

# The https:// address people actually type. Pins the live-update socket to your own site.
# Only meaningful with NODE_ENV=production; unset there, the socket accepts same-origin only.
# PUBLIC_ORIGIN=https://storesdb.ec-workshops.online

# SQLite database file (single-file DB, easy to back up — matches the current setup).
# Designed to port cleanly to PostgreSQL later.
DB_PATH=./data/workshopone.db

# NOT USED. Nothing reads this to sign anything — a session token is 32 random bytes from
# crypto.randomBytes stored server-side in the `sessions` table, so there is no secret to keep.
# This line used to say "CHANGE THIS in production", which sent people hunting a risk that was
# never there while the real one — every seeded account still answering to its own username — sat
# untouched. Kept only so an existing .env does not become invalid. See src/config.js.
SESSION_SECRET=unused

# Session lifetime in hours
SESSION_TTL_HOURS=12

# Where uploaded evidence photos (battery serials, delivered parts, repairs) are stored
UPLOAD_DIR=./uploads

# Automatic DB backups
BACKUP_DIR=./backups
# Optional second location (external drive / network share) mirrored each snapshot.
# BACKUP_MIRROR_DIR=/mnt/backup-drive/workshopone
# How often to snapshot the DB, in minutes (0 disables).
BACKUP_INTERVAL_MINUTES=30
# How many snapshots to retain (96 × 30 min ≈ 48 hours of cover)
BACKUP_RETENTION=96

# Forecasting windows (from the existing Oil & Lubricant Stock Book settings)
FORECAST_WINDOW_DAYS=90
LOW_STOCK_DAYS=14

# --- Service Planner link (optional) ---
# The fuel system knows what each machine has actually RUN — meter growth and fuel-derived
# hours/km — which is the only honest basis for "due for service". WorkshopOne holds no meter or
# fuel data of its own.
#
# Leave the token unset and the link is simply off: no request is attempted, and the Service &
# Filter Plan falls back to its own date estimate and says so on screen. That is the correct state
# on a public server, which cannot reach a planner sitting on the office LAN.
# SERVICE_PLANNER_URL=http://localhost:3300
# SERVICE_PLANNER_TOKEN=          # must match FUEL_PORTAL_TOKEN in the fuel system's .env
