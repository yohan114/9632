{
  "name": "workshopone",
  "version": "0.1.0",
  "description": "WorkshopOne — Central Workshop Master System for Edward & Christie (Pvt) Ltd. Unifies Stores, Oil & Lubricant, and Job Cards so every part, litre, battery and labour hour rolls up to the asset and the job card.",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "reset": "node src/db/migrate.js --reset && node src/db/seed.js",
    "migrate:real": "node src/migrate/run.js --reset",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "admin": "node scripts/admin.js",
    "acceptance": "node scripts/acceptance.js",
    "test": "node --test",
    "cap:init": "cap init WorkshopOne com.edwardchristie.workshopone",
    "cap:sync": "cap sync",
    "build:android": "cap sync android"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "workshop",
    "fleet",
    "inventory",
    "job-cards",
    "costing",
    "sqlite"
  ],
  "author": "Edward & Christie Central Work Shop",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.4.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "socket.io": "^4.7.0"
  }
}
